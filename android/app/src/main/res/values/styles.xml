        <item name="glassStrongColor">#2BFFFFFF</item>
        <item name="strokeColor">#24FFFFFF</item>
        <item name="surfaceStrongColor">#E61A0B2E</item>
        <item name="accentColor">#FFA855F7</item>
        <item name="accentSoftColor">#33A855F7</item>
        <item name="textColorMain">#FFF4F0FF</item>
        <item name="dangerColor">#FFF43F5E</item>
        <item name="okColor">#FF34D399</item>
        <item name="textColorDim">#FF9A8BBF</item>
    </style>

