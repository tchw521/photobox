        <item name="glassStrongColor">#2EFFFFFF</item>
        <item name="strokeColor">#2BFFFFFF</item>
        <item name="surfaceStrongColor">#F01E0B38</item>
        <item name="accentColor">#FFC084FC</item>
        <item name="accentSoftColor">#3DC084FC</item>
        <item name="textColorMain">#FFF7F3FF</item>
        <item name="textColorDim">#FFA08FC4</item>
        <item name="dangerColor">#FFFB7185</item>
        <item name="okColor">#FF4ADE80</item>
        <item name="colorSurface">#FF241040</item>
    </style>

