<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 基础主题：液态玻璃质感，状态栏 / 导航栏全透明以透出渐变底 -->
    <style name="Base.PhotoBox" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_app</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>

        <item name="colorPrimary">?attr/accentColor</item>
        <item name="colorOnPrimary">?attr/textColorMain</item>
        <item name="colorSurface">?attr/glassColor</item>
        <item name="colorOnSurface">?attr/textColorMain</item>
        <item name="colorControlNormal">?attr/textColorDim</item>
        <item name="colorControlActivated">?attr/accentColor</item>

        <item name="android:textColorPrimary">?attr/textColorMain</item>
        <item name="android:textColorSecondary">?attr/textColorDim</item>
        <item name="android:textColorHint">?attr/textColorDim</item>
    </style>

