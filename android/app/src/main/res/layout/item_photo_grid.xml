<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="104dp">

    <ImageView
        android:id="@+id/thumb"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="centerCrop" android:background="@color/glass"/>

    <ImageView
        android:id="@+id/check"
        android:layout_width="22dp" android:layout_height="22dp"
        android:layout_gravity="top|end" android:layout_margin="6dp"
        android:src="@android:drawable/checkbox_on_background"
        android:visibility="gone"/>

    <View android:id="@+id/mask"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="#66A855F7" android:visibility="gone"/>
</FrameLayout>
