<?xml version="1.0" encoding="utf-8"?>
<!--
  极简根布局：只负责结构，颜色与质感全部由代码设置。
  布局中不使用任何 ?attr/，避免主题属性解析导致的 inflate 崩溃。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">

    <!-- 自定义背景图片层：位于内容之下，透明度由「图片浓度遮罩」控制 -->
    <ImageView android:id="@+id/bgLayer"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="centerCrop" android:contentDescription="背景"/>

    <LinearLayout
        android:id="@+id/root"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="horizontal">

        <!-- 左侧相册栏：宽度恒为界面 1/5 -->
        <LinearLayout
            android:id="@+id/sidebar"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="0.2" android:orientation="vertical"
            android:padding="5dp">

            <TextView
                android:id="@+id/sidebarTitle"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="相册分类" android:textSize="11sp"
                android:textStyle="bold" android:padding="5dp" android:gravity="center"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/albumList"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:overScrollMode="never"/>
        </LinearLayout>

        <View android:id="@+id/divider"
            android:layout_width="1dp" android:layout_height="match_parent"/>

        <FrameLayout
            android:id="@+id/content"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="0.8"/>
    </LinearLayout>

    <!-- 底部导航：三个自绘按钮，不使用 Material 组件 -->
    <!-- 悬浮胶囊：宽度收成内容宽并居中，不再横跨整屏 -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:paddingStart="10dp" android:paddingEnd="10dp"
        android:paddingTop="3dp" android:paddingBottom="3dp"
        android:layout_marginBottom="4dp">

        <LinearLayout android:id="@+id/navLibrary"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center"
            android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="2dp" android:paddingBottom="2dp">
            <ImageView android:id="@+id/navLibraryIcon"
                android:layout_width="20dp" android:layout_height="20dp"
                android:contentDescription="图库"/>
            <TextView android:id="@+id/navLibraryText"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="图库" android:textSize="9sp"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/navCards"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center"
            android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="2dp" android:paddingBottom="2dp">
            <ImageView android:id="@+id/navCardsIcon"
                android:layout_width="20dp" android:layout_height="20dp"
                android:contentDescription="卡片"/>
            <TextView android:id="@+id/navCardsText"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="卡片" android:textSize="9sp"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/navSettings"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center"
            android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="2dp" android:paddingBottom="2dp">
            <ImageView android:id="@+id/navSettingsIcon"
                android:layout_width="20dp" android:layout_height="20dp"
                android:contentDescription="设置"/>
            <TextView android:id="@+id/navSettingsText"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="设置" android:textSize="9sp"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
</FrameLayout>
