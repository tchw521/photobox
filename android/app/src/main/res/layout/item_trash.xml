<?xml version="1.0" encoding="utf-8"?>
<!-- 回收站条目 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:padding="6dp" android:layout_marginTop="3dp" android:layout_marginBottom="3dp">

    <ImageView android:id="@+id/thumb"
        android:layout_width="52dp" android:layout_height="52dp"
        android:scaleType="centerCrop" android:contentDescription="照片"/>

    <LinearLayout
        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:orientation="vertical" android:paddingStart="10dp">
        <TextView android:id="@+id/name"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:singleLine="true" android:ellipsize="middle" android:textSize="12sp"/>
        <TextView android:id="@+id/meta"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:singleLine="true" android:textSize="10sp" android:paddingTop="2dp"/>
    </LinearLayout>

    <Button android:id="@+id/restore"
        android:layout_width="wrap_content" android:layout_height="32dp"
        android:text="还原" android:textSize="10sp" android:minWidth="0dp"/>
</LinearLayout>
