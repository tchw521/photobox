<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="72dp"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:padding="8dp" android:background="@drawable/bg_card">
    <ImageView android:id="@+id/thumb" android:layout_width="52dp" android:layout_height="52dp" android:scaleType="centerCrop"/>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:orientation="vertical" android:paddingStart="10dp">
        <TextView android:id="@+id/name" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:singleLine="true" android:ellipsize="middle" android:textSize="12sp" android:textColor="@color/text"/>
        <TextView android:id="@+id/meta" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:singleLine="true" android:textSize="10sp" android:textColor="@color/dim"/>
    </LinearLayout>
    <Button android:id="@+id/restore" android:layout_width="wrap_content" android:layout_height="36dp" android:text="还原" android:textSize="11sp"/>
</LinearLayout>
