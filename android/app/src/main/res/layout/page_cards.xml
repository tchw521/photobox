<?xml version="1.0" encoding="utf-8"?>
<!-- 卡片页：叠放卡片 + 手势提示 + 底部相册栏 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="10dp">

    <TextView android:id="@+id/progress"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="12sp" android:textStyle="bold" android:gravity="center"
        android:paddingBottom="4dp"/>

    <TextView android:id="@+id/tip"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="11sp" android:gravity="center" android:paddingBottom="6dp"/>

    <FrameLayout android:id="@+id/stage"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 三层叠放：c2 最底，c1 居中，c0 最上（当前照片） -->
        <ImageView android:id="@+id/c2"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:scaleType="fitCenter" android:contentDescription="后层照片"/>
        <ImageView android:id="@+id/c1"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:scaleType="fitCenter" android:contentDescription="中层照片"/>
        <ImageView android:id="@+id/c0"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:scaleType="fitCenter" android:contentDescription="当前照片"/>
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center" android:paddingTop="8dp">

        <Button android:id="@+id/btnPrev"
            android:layout_width="wrap_content" android:layout_height="34dp"
            android:text="上一张" android:textSize="11sp" android:minWidth="0dp"
            android:paddingStart="14dp" android:paddingEnd="14dp"/>
        <Button android:id="@+id/btnSkip"
            android:layout_width="wrap_content" android:layout_height="34dp"
            android:text="跳过" android:textSize="11sp" android:minWidth="0dp"
            android:paddingStart="14dp" android:paddingEnd="14dp" android:layout_marginStart="8dp"/>
        <Button android:id="@+id/btnMode"
            android:layout_width="wrap_content" android:layout_height="34dp"
            android:text="移动模式" android:textSize="11sp" android:minWidth="0dp"
            android:paddingStart="14dp" android:paddingEnd="14dp" android:layout_marginStart="8dp"/>
        <Button android:id="@+id/btnTrash"
            android:layout_width="wrap_content" android:layout_height="34dp"
            android:text="回收" android:textSize="11sp" android:minWidth="0dp"
            android:paddingStart="14dp" android:paddingEnd="14dp" android:layout_marginStart="8dp"/>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="归类到相册（点击即归档）" android:textSize="10sp"
        android:gravity="center" android:paddingTop="10dp" android:paddingBottom="4dp"/>

    <androidx.recyclerview.widget.RecyclerView android:id="@+id/albumBar"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:overScrollMode="never"/>
</LinearLayout>
