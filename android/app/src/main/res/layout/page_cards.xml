<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="8dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/progress" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="0 / 0" android:textSize="14sp"
            android:textColor="?attr/textColorMain" android:textStyle="bold" android:letterSpacing="0.03"/>
        <Button android:id="@+id/btnMode" style="?android:attr/buttonBarButtonStyle"
            android:layout_width="wrap_content" android:layout_height="30dp" android:text="移动" android:textSize="11sp"
            android:textColor="?attr/accentColor"/>
    </LinearLayout>

    <FrameLayout android:id="@+id/stage" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1">
        <ImageView android:id="@+id/card2" android:layout_width="196dp" android:layout_height="252dp"
            android:layout_gravity="center" android:scaleType="centerCrop" android:alpha="0.42"
            android:background="@drawable/thumb_ring" android:clipToOutline="true"/>
        <ImageView android:id="@+id/card1" android:layout_width="210dp" android:layout_height="268dp"
            android:layout_gravity="center" android:scaleType="centerCrop" android:alpha="0.7"
            android:background="@drawable/thumb_ring" android:clipToOutline="true"/>
        <ImageView android:id="@+id/card0" android:layout_width="224dp" android:layout_height="284dp"
            android:layout_gravity="center" android:scaleType="centerCrop"
            android:background="@drawable/thumb_ring" android:clipToOutline="true"/>
    </FrameLayout>

    <TextView android:id="@+id/cardTip" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="11sp" android:textColor="?attr/textColorDim" android:gravity="center" android:padding="5dp"/>

    <TextView android:id="@+id/cardName" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center" android:textSize="13sp" android:textColor="?attr/textColorMain"
        android:singleLine="true" android:ellipsize="middle" android:paddingBottom="4dp"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center">
        <Button android:id="@+id/btnPrev" style="?android:attr/buttonBarButtonStyle"
            android:layout_width="wrap_content" android:layout_height="32dp" android:text="上一张" android:textSize="11sp"
            android:textColor="?attr/textColorDim"/>
        <Button android:id="@+id/btnSkip" style="?android:attr/buttonBarButtonStyle"
            android:layout_width="wrap_content" android:layout_height="32dp" android:text="跳过" android:textSize="11sp"
            android:textColor="?attr/textColorDim"/>
        <Button android:id="@+id/btnTrash" style="?android:attr/buttonBarButtonStyle"
            android:layout_width="wrap_content" android:layout_height="32dp" android:text="清理" android:textSize="11sp"
            android:textColor="?attr/dangerColor"/>
    </LinearLayout>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="归类到相册（点击即归档）" android:textSize="10sp" android:textColor="?attr/textColorDim"
        android:gravity="center" android:paddingTop="6dp" android:letterSpacing="0.05"/>

    <androidx.recyclerview.widget.RecyclerView android:id="@+id/cardAlbums"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:overScrollMode="never"/>
</LinearLayout>
