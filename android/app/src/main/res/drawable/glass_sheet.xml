<?xml version="1.0" encoding="utf-8"?>
<!-- 底部弹层：玻璃底 + 顶部高光 + 描边，上圆角 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/glassStrongColor"/>
            <corners android:topLeftRadius="22dp" android:topRightRadius="22dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="270"
                android:startColor="#2BFFFFFF" android:endColor="#00FFFFFF"/>
            <corners android:topLeftRadius="22dp" android:topRightRadius="22dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="?attr/strokeColor"/>
            <corners android:topLeftRadius="22dp" android:topRightRadius="22dp"/>
        </shape>
    </item>
</layer-list>
