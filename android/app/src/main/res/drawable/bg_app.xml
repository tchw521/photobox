<?xml version="1.0" encoding="utf-8"?>
<!--
  液态玻璃底：三层叠加
  1. 主渐变（315° 斜向）
  2. 左上强调色径向光晕（模拟环境光透射）
  3. 右下冷色径向光晕（制造纵深）
  全部用皮肤色，换肤后自动重绘。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="315"
                android:startColor="?attr/bgTopColor"
                android:centerColor="?attr/bgMidColor"
                android:endColor="?attr/bgBottomColor"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="radial" android:gradientRadius="78%p"
                android:centerX="0.18" android:centerY="0.12"
                android:startColor="?attr/glowColor"
                android:endColor="#00000000"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="radial" android:gradientRadius="62%p"
                android:centerX="0.88" android:centerY="0.94"
                android:startColor="?attr/glowColor2"
                android:endColor="#00000000"/>
        </shape>
    </item>
</layer-list>
