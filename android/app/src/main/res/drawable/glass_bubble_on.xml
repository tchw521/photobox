<?xml version="1.0" encoding="utf-8"?>
<!-- 选中态气泡：强调色底 + 高光 + 强调描边 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/accentSoftColor"/>
            <corners android:radius="999dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="270"
                android:startColor="#33FFFFFF" android:endColor="#00FFFFFF"/>
            <corners android:radius="999dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1.2dp" android:color="?attr/accentColor"/>
            <corners android:radius="999dp"/>
        </shape>
    </item>
</layer-list>
