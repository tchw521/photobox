<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/accentSoftColor"/>
            <stroke android:width="1.2dp" android:color="?attr/accentColor"/>
            <corners android:radius="18dp"/>
        </shape>
    </item>
    <item android:top="0.6dp" android:left="0.6dp" android:right="0.6dp">
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="270"
                android:startColor="#2EFFFFFF" android:centerColor="#0AFFFFFF" android:endColor="#00FFFFFF"/>
            <corners android:radius="18dp"/>
        </shape>
    </item>
</layer-list>
