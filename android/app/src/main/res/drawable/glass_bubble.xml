<?xml version="1.0" encoding="utf-8"?>
<!-- 胶囊气泡：玻璃底 + 顶部高光 + 描边 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/glassColor"/>
            <corners android:radius="999dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="270"
                android:startColor="#22FFFFFF" android:endColor="#00FFFFFF"/>
            <corners android:radius="999dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="?attr/strokeColor"/>
            <corners android:radius="999dp"/>
        </shape>
    </item>
</layer-list>
