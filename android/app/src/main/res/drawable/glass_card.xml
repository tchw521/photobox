<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/glassColor"/>
            <stroke android:width="1dp" android:color="?attr/strokeColor"/>
            <corners android:radius="16dp"/>
        </shape>
    </item>
    <item android:top="0.8dp" android:left="0.8dp" android:right="0.8dp">
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="270"
                android:startColor="#16FFFFFF" android:endColor="#00FFFFFF"/>
            <corners android:radius="16dp"/>
        </shape>
    </item>
</layer-list>
